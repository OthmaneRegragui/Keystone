# Environment: "test" | "development" | "production"
APP_ENV=development

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# CORS
# Comma-separated list of origins allowed to call the API from the browser
# (KEYSTONE__CORS__ALLOWED_ORIGINS takes precedence when both are set).
# No wildcard: a literal "*" is never treated as a permissive wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
# The server builds its connection URL from the POSTGRES_* vars below, so there
# is no DATABASE_URL to maintain:
#   bare-metal: postgres://<user>:<password>@localhost:<POSTGRES_PORT>/<db>
#   docker:     the compose `server` service is pointed at the `postgres`
#               container automatically via KEYSTONE__DATABASE__URL
#               (postgres://<user>:<password>@postgres:5432/<db>)
# Set DATABASE_URL (or KEYSTONE__DATABASE__URL) explicitly to override.
POSTGRES_USER=keystone
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=keystone
# Host port the compose `postgres` service is published to (container port stays
# 5432). Also used as the port in the derived bare-metal URL.
# Default 5433 so it cannot collide with a local Postgres on 5432.
# Set POSTGRES_PORT=5432 to use the standard port.
POSTGRES_PORT=5433

# Storage — comma-separated list of directories to store files
# First path is the default (new uploads go here)
# Add more paths to spread files across multiple disks
# Example: STORAGE_LOCAL_PATHS=/mnt/disk1/storage,/mnt/disk2/storage,/mnt/disk3/storage
# Docker deployment: this must be an ABSOLUTE path inside the server container
# (compose default: /mnt/keystone/data). Inside the container, bucket files land at:
#   $STORAGE_LOCAL_PATHS/<storage-path-slug>/<bucket-name>/<blake3-shards>
# e.g. /mnt/keystone/data/test1/test1/fc/bd/<blake3-hash>
# On the host: /var/lib/docker/volumes/<project>_storagedata/_data/...
# Bare-metal dev can use a relative dir instead, e.g. ./storage
STORAGE_LOCAL_PATHS=/mnt/keystone/data
STORAGE_MAX_UPLOAD_SIZE_MB=100

# DATA_HOST_PATH — where uploaded files live OUTSIDE the container (host side
# of the mount). The server always sees $STORAGE_LOCAL_PATHS inside the
# container; this variable only decides what the folder is mounted FROM:
#
#   DATA_HOST_PATH=           (empty/unset)  Docker named volume "storagedata".
#                                             Default. Data is hidden on the host
#                                             at /var/lib/docker/volumes/<project>_storagedata/_data
#   DATA_HOST_PATH=./data                     A real folder inside the project
#                                             (./data next to docker-run.sh).
#                                             Files are directly visible/backable.
#   DATA_HOST_PATH=/mnt/disk1/keystone        Bind mount to any absolute host path.
#
# Relative paths are anchored to the project root when you use ./docker-run.sh.
# If you run `docker compose` directly, either use an absolute path or add
# `--project-directory .` so ./data means the project root.
#
# Switching from the default volume to a folder: copy the existing data once,
# then restart:
#   mkdir -p data
#   docker run --rm -v keystone_storagedata:/from -v "$PWD/data":/to alpine \
#     sh -c 'cp -a /from/. /to/ && chown -R 1000:1000 /to'
#   (set DATA_HOST_PATH=./data, then ./docker-run.sh)
# Keep STORAGE_LOCAL_PATHS as-is — it is the container-side path, never change
# it to match the host path.
DATA_HOST_PATH=

# Auth
# JWT_SECRET and ENCRYPTION_TOKEN below are PLACEHOLDERS: in production the
# server refuses to start with them (or with any value containing "change-me",
# or shorter than 32/16 bytes). Generate real values with:
#   openssl rand -base64 32
# (If you prefer the KEYSTONE__-prefixed forms, KEYSTONE__AUTH__JWT_SECRET and
# KEYSTONE__SECURITY__ENCRYPTION_TOKEN take precedence when both are set.)
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32
JWT_EXPIRY_MINUTES=15
# How long refresh tokens stay valid (the server derives minutes = days * 24 * 60).
REFRESH_EXPIRY_DAYS=30

# Security
# Token used to encrypt/decrypt sensitive values at rest.
# Generate one with: openssl rand -base64 32
# (must be stable across restarts — rotating it invalidates previously
#  encrypted data unless you migrate it)
ENCRYPTION_TOKEN=change-me-generate-with-openssl-rand-base64-32

# Workers
WORKER_GC_INTERVAL_SECS=3600
WORKER_INTEGRITY_INTERVAL_SECS=86400
WORKER_STATS_INTERVAL_SECS=300
