FROM rust:1.88-slim AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# crates.io can stall on slow or flaky links. Allow low-speed downloads to keep
# retrying instead of aborting the whole image build.
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse \
    CARGO_HTTP_TIMEOUT=600 \
    CARGO_HTTP_LOW_SPEED_LIMIT=1 \
    CARGO_HTTP_MULTIPLEXING=false \
    CARGO_NET_RETRY=10

# Cache dependencies: copy manifests first, then build the whole dependency
# graph against a dummy lib/bin.
#
# Everything cargo writes — the compiled `target` dir, the crates.io registry
# and git checkouts — lives in a BuildKit *cache mount*, never in an image
# layer. A layer holding compiled deps is ~1 GB, and BuildKit keeps every
# distinct layer around, so committing deps to a layer grows the build cache by
# ~1 GB per build (it reached 44 GB here). That bloat is also what broke fast
# updates: the resulting GC pressure evicted the warm cache, turning a routine
# 30s source change into a full ~380-crate recompile (~4 min). A cache mount is
# a single entry updated in place, so the cache stays a couple of GB no matter
# how many times you build and updates stay fast.
#
# Reclaim other cache safely (this keeps the mounts above warm):
#     docker buildx prune -f --filter type=regular
COPY Cargo.toml Cargo.lock ./
RUN --mount=type=cache,id=keystone-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=keystone-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=keystone-cargo-target,target=/app/target,sharing=locked \
    mkdir src && \
    echo '' > src/lib.rs && \
    echo 'fn main() {}' > src/main.rs && \
    cargo build --release --locked --bin keystone && \
    rm -rf src

# Copy full source and rebuild. Only this crate changed, so cargo reuses the
# dependencies compiled above and just relinks the binary.
COPY src/ src/
COPY migrations/ migrations/
RUN --mount=type=cache,id=keystone-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=keystone-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=keystone-cargo-target,target=/app/target,sharing=locked \
    touch src/main.rs src/lib.rs && \
    cargo build --release --locked --bin keystone && \
    cp target/release/keystone /app/server

# --- Runtime ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libpq5 curl && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash keystone

WORKDIR /app

COPY --from=builder /app/server /app/server

# Prepare the storage mount point (the "storagedata" volume mounts here).
# /mnt exists in the base image; /mnt/keystone is created for the volume.
RUN mkdir -p /mnt/keystone/data && \
    chown -R keystone:keystone /mnt/keystone

# The entrypoint starts as root so it can make the mounted storage volume
# writable by the `keystone` user (a mounted volume hides the chown above),
# then drops privileges via setpriv and execs the server.
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/app/server"]
