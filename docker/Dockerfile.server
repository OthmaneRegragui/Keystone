FROM rust:1.88-slim AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cache dependencies: copy manifests first, create a dummy lib to build deps
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && \
    echo '' > src/lib.rs && \
    echo 'fn main() {}' > src/main.rs && \
    cargo build --release --bin keystone && \
    rm -rf src

# Copy full source and rebuild (only source changed, deps cached)
COPY src/ src/
COPY migrations/ migrations/
RUN touch src/main.rs src/lib.rs && cargo build --release --bin keystone

# --- Runtime ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libpq5 curl && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash keystone

WORKDIR /app

COPY --from=builder /app/target/release/keystone /app/server

# Prepare the storage mount point (the "storagedata" volume mounts here).
# /mnt exists in the base image; /mnt/keystone is created for the volume.
RUN mkdir -p /mnt/keystone/data && \
    chown -R keystone:keystone /mnt/keystone

USER keystone

EXPOSE 3000

CMD ["/app/server"]
